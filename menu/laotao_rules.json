    {"no": 10, "who": "男工人", "appear": "[肉食]/<肉块>", "lines": [
      {"text": "肉。", "cond": "[肉食]", "examples": ["金丝小贝", "坛子肉", "界龙肉卷"]},
      {"text": "好肉。汤不行。", "cond": "非汤羹 <优质肉块>", "examples": ["界龙肉卷", "老麻抄手", "福寿全", "麻辣香锅", "坛子肉", "烤肉串", "金丝小贝"]},
      {"text": "肉。菜肴。", "cond": "菜肴 <肉块>", "examples": ["福寿全", "麻辣香锅", "坛子肉", "烤肉串", "鳞香肉丝"]},
      {"text": "喝的。茶。", "cond": "[茶香]", "kind": "drink"},
      {"text": "喝的。果味不行。", "cond": "非[果香]", "kind": "drink"}
    ]},
    {"no": 11, "who": "女学生", "appear": "[素食]/<多味菇>", "lines": [
      {"text": "哎你们有没有素的？", "cond": "[素食]", "examples": ["“银耳莲子”羹", "奶油蘑菇汤", "果味沙拉"]},
      {"text": "哎你们有没有多味菇的汤？", "cond": "汤羹 <多味菇>", "note": "表里写优质，但示例银耳莲子羹用的是普通多味菇，按示例放宽", "examples": ["“银耳莲子”羹", "奶油蘑菇汤"]},
      {"text": "哎你们有没有多味菇菜肴？", "cond": "菜肴 <优质多味菇>", "examples": ["福寿全", "“勺里游”", "麻辣香锅", "果味沙拉"]},
      {"text": "哎你们有没有无酒精饮料？", "cond": "非[酒香]", "kind": "drink"},
      {"text": "哎你们有没有古典清新饮料？", "cond": "[茶香]", "kind": "drink"}
    ]},
    {"no": 12, "who": "女农民", "appear": "[水产]/<鳞肉>", "lines": [
      {"text": "好时节！该吃水中之物！", "cond": "[水产]", "examples": ["糖醋宝鳞", "白鳞高汤", "茄果鳞肉汤"]},
      {"text": "上好水产！不要做成汤羹！", "cond": "非汤羹 <优质鳞肉>", "examples": ["至臻鳞肉卷", "鳞肉水饺", "糖醋宝鳞", "福寿全"]},
      {"text": "鳞肉菜式！做成主食！", "cond": "主食 <鳞肉>", "examples": ["至臻鳞肉卷", "鳞肉水饺"]},
      {"text": "来点喝的，别有奶腥味。", "cond": "非[奶香]", "kind": "drink"},
      {"text": "佐餐饮品来一些，可别让我上头。", "cond": "非[酒香]", "kind": "drink"}
    ]},
    {"no": 13, "who": "少女工程师", "appear": "[滋补]/<青叶莓>", "lines": [
      {"text": "吃东西还是要滋补的。", "cond": "[滋补]", "examples": ["福寿全", "千果珍珠圆", "白瓜肉丸汤", "莓果甜汤"]},
      {"text": "优质青叶莓还是不适合当主食。", "cond": "非主食 <优质青叶莓>"},
      {"text": "优质青叶莓还是要做成甜品。", "cond": "甜品 <优质青叶莓>", "examples": ["红蕊奶酪蛋糕", "千果珍珠圆"]},
      {"text": "饮品还是得喝有青叶莓的。", "cond": "[果香]", "kind": "drink"},
      {"text": "这次不喝青叶莓了，喝点奶。", "cond": "[奶香]", "kind": "drink"}
    ]},
    {"no": 14, "who": "女工人", "appear": "[美观]/<一百三十香>", "lines": [
      {"text": "别丑就行，好看最重要。", "cond": "[美观]", "examples": ["界龙肉卷", "八宝饭", "红蕊奶酪蛋糕", "簇锦豆腐羹"]},
      {"text": "让我见识见识一百三十香。", "cond": "<一百三十香>", "examples": ["界龙肉卷", "簇锦豆腐羹"]}
    ]},
    {"no": 15, "who": "女教师", "appear": "[雅致]/<球豆>", "lines": [
      {"text": "菜肴都丑，上点好看的。", "cond": "菜肴 [美观]"},
      {"text": "饮料都挺不错，上果香奶香的吧。", "cond": "[果香]/[奶香]", "kind": "drink"},
      {"text": "夫用膳者，理应雅致为先。", "cond": "[雅致]", "examples": ["糖醋宝鳞", "雪纱蛋黄月饼", "簇锦豆腐羹", "“银耳莲子”羹"]},
      {"text": "夫品汤羹者，理应善用球豆。", "cond": "汤羹 <球豆>", "examples": ["簇锦豆腐羹", "“银耳莲子”羹", "奶油蘑菇汤", "莓果甜汤"]},
      {"text": "夫擅烹球豆者，理应舍去甜腻。", "cond": "<球豆> 非<砂糖>", "examples": ["豌杂拌面", "雪绵豆沙", "簇锦豆腐羹", "奶油蘑菇汤"]},
      {"text": "夫好饮者，理应茶酒为先。", "cond": "[茶香]/[酒香]", "kind": "drink"}
