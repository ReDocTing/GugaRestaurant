{
  "_说明": [
    "老饕点餐需求表，从 menu/ 里别人整理的截图（老饕活动要求 页）转录。",
    "appear：菜单里有这个标签/配料，这位老饕才会来。",
    "cond 写法（空格分开的条件全部要满足）：",
    "  主食/菜肴/甜品/汤羹 = 菜的类别；非主食 = 不能是主食",
    "  [咸] = 带这个标签；非[甜] = 不能带",
    "  <鳞肉> 或 <(优质)鳞肉> = 配料里有鳞肉（普通、优质都行）；<优质鳞肉> = 必须是优质的；非<砂糖> = 不能有",
    "  A/B = 满足其一",
    "  饮品的标签：[果香] [奶香] [茶香] [酒香]",
    "examples：表里列出的符合条件的菜（只用来核对转录有没有错）。",
    "缺：1~4 号、13 号截图里没拍到饮品那几行；8 号的两句饮品放在 9 号上方，按「予我」句式归到 8 号。"
  ],
  "laotao": [
    {"no": 1, "who": "大壮汉工人", "appear": "主食", "lines": [
      {"text": "充充碳吧，我是说，米饭。", "cond": "主食 <金石稻>", "examples": ["八宝饭", "手抓饭", "青菜养生粥", "缘缘菜饭"]},
      {"text": "补点碳水，来点够咸的。", "cond": "主食 [咸]", "examples": ["老麻抄手", "手抓饭"]},
      {"text": "碳水碳水，来点够鲜的。", "cond": "主食 [鲜]", "examples": ["至臻鳞肉卷", "鳞肉水饺"]},
      {"text": "管饱的碳水，但别辣。", "cond": "主食 非[辣]", "examples_not": ["老麻抄手", "豌杂拌面"]},
      {"text": "我要不花哨且管饱的碳水！", "cond": "主食 非[美观] 非[雅致]", "examples_not": ["界龙肉卷", "八宝饭"]}
    ]},
    {"no": 2, "who": "胖教师", "appear": "菜肴", "lines": [
      {"text": "菜肴之美，在于无鳞不成席呀。", "cond": "菜肴 <鳞肉>", "examples": ["糖醋宝鳞", "福寿全", "酸菜鳞肉"]},
      {"text": "菜肴之妙，在于远离菌菇呀。", "cond": "菜肴 非<多味菇>", "examples_not": ["福寿全", "“勺里游”", "麻辣香锅", "果味沙拉", "烤肉串"]},
      {"text": "菜肴之礼，在于以酸开胃呀。", "cond": "菜肴 [酸]", "examples": ["果味沙拉", "酸菜鳞肉"]},
      {"text": "菜肴之勇，在于辛辣之巧呀。", "cond": "菜肴 [辣]", "examples": ["麻辣香锅", "烤肉串"]},
      {"text": "菜肴之智，在于远离甜腻呀。", "cond": "菜肴 非[甜]", "examples_not": ["“勺里游”", "坛子肉", "鳞香肉丝"]}
    ]},
    {"no": 3, "who": "小孩", "appear": "甜品", "lines": [
      {"text": "那种，有奶香味的甜糕点。", "cond": "甜品 <兽奶>", "examples": ["红蕊奶酪蛋糕", "千果珍珠圆", "酸莓布丁", "咸酪脆饼", "鲜奶炖蛋"]},
      {"text": "那种，有蛋香味的甜糕点。", "cond": "甜品 <禽蛋>", "examples": ["红蕊奶酪蛋糕", "雪纱蛋黄月饼", "金丝小贝", "雪绵豆沙", "咸酪脆饼", "鲜奶炖蛋"]},
      {"text": "那种，不会蛀牙的糕点。", "cond": "甜品 非<砂糖>", "examples_not": ["千果珍珠圆", "雪纱蛋黄月饼", "金丝小贝", "豆沙汤圆", "糯米凉糕"]},
      {"text": "那种，咸咸的美味糕点。", "cond": "甜品 [咸]", "examples": ["雪纱蛋黄月饼", "金丝小贝", "咸酪脆饼"]},
      {"text": "那些，酸酸甜甜的下午茶糕点。", "cond": "甜品 [酸]/[甜]", "examples": ["红蕊奶酪蛋糕", "千果珍珠圆", "雪绵豆沙", "酸莓布丁", "豆沙汤圆"]}
    ]},
    {"no": 4, "who": "老人", "appear": "汤羹", "lines": [
      {"text": "可有靓汤？莫放球豆。", "cond": "汤羹 非<球豆>", "examples_not": ["簇锦豆腐羹", "“银耳莲子”羹", "奶油蘑菇汤", "莓果甜汤"]},
      {"text": "可有靓汤？雅致当先。", "cond": "汤羹 [雅致]"}
    ]},
    {"no": 5, "who": "小学生", "appear": "[鲜]", "lines": [
      {"text": "百膳鲜为先，只是不爱鳞。", "cond": "[鲜] 非<鳞肉>", "examples": ["“勺里游”", "白瓜肉丸汤"]},
      {"text": "百膳鲜为先，滋补味更深。", "cond": "[鲜] [滋补]", "examples": ["福寿全", "白瓜肉丸汤"]},
      {"text": "百膳鲜为先，汤羹却下乘。", "cond": "非汤羹 [鲜]", "examples": ["福寿全", "“勺里游”", "至臻鳞肉卷", "鳞肉水饺"]},
      {"text": "且来些饮料，唯独不要茶。", "cond": "非[茶香]", "kind": "drink"},
      {"text": "且来些饮料，以果味为佳。", "cond": "[果香]", "kind": "drink"}
    ]},
    {"no": 6, "who": "男农民", "appear": "[咸]", "lines": [
      {"text": "咸口的随意上些，不要汤羹。", "cond": "非汤羹 [咸]", "examples": ["老麻抄手", "手抓饭", "麻辣香锅", "炸薯条", "雪纱蛋黄月饼", "金丝小贝", "咸酪脆饼"]},
      {"text": "随意上些，咸一点，不要肉食。", "cond": "[咸] 非<肉块>", "examples": ["炸薯条", "雪纱蛋黄月饼", "咸酪脆饼", "奶油蘑菇汤"]},
      {"text": "来点少油吃食，但盐要多放。", "cond": "[咸] 非<菜籽油>", "examples": ["手抓饭", "麻辣香锅", "雪纱蛋黄月饼", "金丝小贝", "咸酪脆饼", "奶油蘑菇汤"]},
      {"text": "随意上些饮品，不要有果味。", "cond": "非[果香]", "kind": "drink"},
      {"text": "什么喝的都行，但要清口解腻。", "cond": "[茶香]", "kind": "drink"}
    ]},
    {"no": 7, "who": "少年工程师", "appear": "[辣]", "lines": [
      {"text": "啥都行！多辣！不要主食！", "cond": "非主食 [辣]", "examples": ["麻辣香锅", "烤肉串", "酸辣汤"]},
      {"text": "上点吃食，重辣不倒牙就行。", "cond": "[辣] 非[酸]", "examples": ["老麻抄手", "豌杂拌面", "麻辣香锅", "烤肉串"]},
      {"text": "肉要上品，而且要辣，很辣！", "cond": "[辣] <优质肉块>", "examples": ["老麻抄手", "麻辣香锅", "烤肉串"]},
      {"text": "喝的！啥都行！但不能醉人！", "cond": "非[酒香]", "kind": "drink"},
      {"text": "来杯喝的，别有草叶子味！", "cond": "非[茶香]", "kind": "drink"}
    ]},
    {"no": 8, "who": "小孩", "appear": "[甜]", "lines": [
      {"text": "可有甘甜果味之物予我？", "cond": "[甜] <青叶莓>", "examples": ["八宝饭", "千果珍珠圆", "莓果甜汤"]},
      {"text": "可有味甜无肉之物予我？", "cond": "[甜] 非<肉块>", "examples": ["八宝饭", "“勺里游”", "千果珍珠圆", "雪绵豆沙", "豆沙汤圆", "莓果甜汤"]},
      {"text": "可有味甜而非糕点之物予我？", "cond": "非甜品 [甜]", "examples": ["莓果甜汤", "“勺里游”", "坛子肉", "鳞香肉丝", "八宝饭"]},
      {"text": "可有麻辣之饮予我？", "cond": "非[酒香]", "kind": "drink"},
      {"text": "可有乳饮予我？", "cond": "[奶香]", "kind": "drink"}
    ]},
    {"no": 9, "who": "男工程师", "appear": "[酸]", "lines": [
      {"text": "我看……茄果菜式，酸能提味。", "cond": "[酸] <茄果>", "examples": ["至臻鳞肉卷", "果味沙拉", "茄果鳞肉汤"]},
      {"text": "嗯……鳞肉菜式，要有鲜腻酸味。", "cond": "[酸] <鳞肉>", "examples": ["茄果鳞肉汤", "酸菜鳞肉", "至臻鳞肉卷"]},
      {"text": "我想……酸味菜肴，不要做成甜品。", "cond": "非甜品 [酸]", "examples": ["至臻鳞肉卷", "果味沙拉", "酸菜鳞肉", "茄果鳞肉汤", "酸辣汤"]},
      {"text": "或许……随意饮品？但我乳糖不耐。", "cond": "非[奶香]", "kind": "drink"},
      {"text": "没错……理应小酌几杯。", "cond": "[酒香]", "kind": "drink"}
